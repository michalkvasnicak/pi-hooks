{
  "agent_before_settle": {
    "failFast": true,
    "checks": [
      {
        "name": "Lint",
        "type": "command",
        "command": "pnpm lint",
        "inputs": [
          "src/**/*.ts",
          ".oxlintrc.json",
          "package.json",
          "pnpm-lock.yaml"
        ]
      },
      {
        "name": "TypeScript check",
        "type": "command",
        "command": "pnpm check",
        "inputs": [
          "src/**/*.ts",
          "tsconfig.json",
          "package.json",
          "pnpm-lock.yaml"
        ]
      }
    ]
  }
}
