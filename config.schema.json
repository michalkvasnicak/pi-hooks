{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pi-hooks configuration",
  "description": "Checks run by pi-hooks at supported Pi lifecycle events.",
  "type": "object",
  "properties": {
    "hooks": {
      "type": "object",
      "properties": {
        "tool_call": {
          "type": "object",
          "description": "Rules applied before tool execution and after successful tool results.",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "match": { "$ref": "#/$defs/toolMatch" },
                      "action": { "const": "block" },
                      "reason": { "type": "string", "minLength": 1 }
                    },
                    "required": ["match", "action", "reason"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "match": { "$ref": "#/$defs/toolMatch" },
                      "action": { "const": "nudge" },
                      "text": { "type": "string", "minLength": 1 }
                    },
                    "required": ["match", "action", "text"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": ["rules"],
          "additionalProperties": false
        },
        "agent_before_settle": {
          "type": "object",
          "properties": {
            "failFast": {
              "type": "boolean",
              "default": true,
              "description": "Stop running checks at the first failure. Defaults to true."
            },
            "maxRetries": {
              "type": "integer",
              "minimum": 0,
              "default": 5,
              "description": "Maximum automatic continuations after failed checks. Defaults to 5."
            },
            "checks": {
              "type": "array",
              "description": "Checks run before the agent settles. A failed check is sent back to the agent as a message.",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Optional display name; defaults to its 1-based position."
                      },
                      "inputs": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 },
                        "description": "Glob patterns for files that affect this check. When omitted, the check always runs."
                      },
                      "type": {
                        "const": "command"
                      },
                      "command": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Shell command; a non-zero exit status is a failure."
                      }
                    },
                    "required": ["type", "command"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Optional display name; defaults to its 1-based position."
                      },
                      "inputs": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 },
                        "description": "Glob patterns for files that affect this check. When omitted, the check always runs."
                      },
                      "type": {
                        "const": "script"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Path, relative to the repository root, to a module with a default-exported async function."
                      }
                    },
                    "required": ["type", "path"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": ["checks"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "toolMatch": {
      "type": "object",
      "properties": {
        "tool": { "type": "string", "minLength": 1, "description": "Tool name glob pattern." },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "description": "Glob pattern for a top-level string argument."
          }
        }
      },
      "required": ["tool"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
